# DeepSeek API key — required. Get one from https://platform.deepseek.com
DEEPSEEK_API_KEY=

# Optional: override the DeepSeek model (defaults to deepseek-v4-flash)
DEEPSEEK_MODEL=deepseek-v4-flash

# Optional: comma-separated list of allowed frontend origins for CORS
FRONTEND_ORIGIN=http://localhost:5173
