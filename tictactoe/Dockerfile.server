# ---- Frontend build stage ----
FROM node:22-alpine AS frontend

WORKDIR /frontend

COPY frontend/package*.json ./
RUN npm ci

COPY frontend/ .
RUN npm run build

# ---- Go build stage ----
FROM golang:1.26-alpine AS builder

WORKDIR /app

# Copy go.mod (and go.sum if present) first for better layer caching. The
# glob keeps this working even though the module has no dependencies and
# therefore no go.sum yet.
COPY backend/go.mod backend/go.sum* ./
RUN go mod download

# Copy the rest of the source
COPY backend/ .

# Build a static binary for the REST API only.
RUN CGO_ENABLED=0 GOOS=linux go build -o app ./cmd/server

# ---- Final stage ----
FROM alpine:3.20

WORKDIR /app

COPY --from=builder /app/app .
COPY --from=frontend /frontend/dist ./dist

EXPOSE 8080
ENTRYPOINT ["./app", "-http=:8080", "-static=/app/dist"]
